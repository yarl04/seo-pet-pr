---
import { withBase } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import RecipeGrid from '../components/RecipeGrid.astro';
import { recipes } from '../data/recipes';
import { categories } from '../data/categories';
import { recipeCount } from '../lib/recipes';
import { listSchema } from '../lib/seo';
const featured = ['tomato-pasta', 'banana-pancakes', 'greek-salad', 'chicken-vegetables'].map((slug) => recipes.find((r) => r.slug === slug)!);
---
<Layout title="Что приготовить за 30 минут — простые рецепты на каждый день" description="Выберите завтрак, обед или ужин за 30 минут. 12 простых рецептов с фотографиями, точными пропорциями и пошаговым приготовлением." schema={[listSchema(featured, Astro.site!)]}>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-sun" aria-hidden="true">✳</span> Обычные продукты. Отличная еда.</p>
        <h1 id="hero-title">Что приготовить<br />за <span class="highlight">30 минут?</span></h1>
        <p class="hero-description">На каждый день, под настроение и из того,<br class="desktop-break" /> что уже есть в холодильнике.</p>
        <a class="button button-primary" href={withBase('/recipes/')}>Найти свой рецепт <span aria-hidden="true">↗</span></a>
        <p class="hero-note"><span aria-hidden="true">✓</span> Простые шаги. Никаких редких ингредиентов.</p>
      </div>
      <div class="hero-visual">
        <img class="hero-photo" src={withBase('/images/tomato-pasta.jpg')} width="700" height="700" alt="Пенне в томатном соусе с базиликом и сыром" fetchpriority="high" />
        <div class="timer-stamp" aria-hidden="true"><span>Всё успеется</span><strong>30</strong><span>минут — и к столу</span></div>
        <a class="hero-recipe" href={withBase('/recipes/tomato-pasta/')}><span><small>Сегодня на ужин</small><strong>Паста с томатами и базиликом</strong></span><span class="hero-recipe-time">20 мин <span aria-hidden="true">↗</span></span></a>
      </div>
    </section>
    <section class="section" aria-labelledby="categories-title">
      <div class="section-heading"><div><p class="eyebrow">На любой момент дня</p><h2 id="categories-title">Начнём с повода</h2></div><p class="section-note">Утро, день или уютный вечер.</p></div>
      <ul class="category-grid" role="list">
        {categories.map((category) => {
          const recipe = recipes.find((r) => r.slug === category.imageRecipe)!;
          return <li><a class={`category-link category-${category.id}`} href={withBase(`/categories/${category.id}/`)}><div><span class="category-subtitle">{category.subtitle}</span><h3>{category.name}</h3><span>{recipeCount(recipes.filter((r) => r.category === category.id).length)} <span aria-hidden="true">↗</span></span></div><img src={withBase(recipe.image)} alt="" width="150" height="150" loading="lazy" /></a></li>;
        })}
      </ul>
    </section>
    <section class="section" aria-labelledby="featured-title">
      <div class="section-heading"><div><p class="eyebrow">Не усложняем</p><h2 id="featured-title">Простые идеи на сегодня</h2></div><a class="text-link" href={withBase('/recipes/')}>Все {recipeCount(recipes.length)} <span aria-hidden="true">↗</span></a></div>
      <RecipeGrid recipes={featured} />
    </section>
    <aside class="kitchen-note" aria-labelledby="kitchen-note-title"><span class="note-symbol" aria-hidden="true">✳</span><div><h2 id="kitchen-note-title">Полчаса — с подготовкой продуктов</h2><p>Мы учитываем и нарезку, и время у плиты. Сначала прочитайте рецепт целиком, достаньте продукты — и можно начинать.</p></div><a class="text-link" href={withBase('/recipes/?time=15')}>Есть только 15 минут? <span aria-hidden="true">↗</span></a></aside>
  </div>
</Layout>
