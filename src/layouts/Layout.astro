---
import { withBase } from '../lib/urls';
import '@fontsource-variable/manrope';
import '@fontsource-variable/golos-text';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { LayoutProps } from '../types/ui';
import { absoluteUrl, serializeSchema } from '../lib/seo';
const { title, description, image = '/images/tomato-pasta.jpg', imageAlt = 'Паста с томатами и базиликом', schema = [], noindex = false } = Astro.props as LayoutProps;
const site = Astro.site!;
const canonical = absoluteUrl(Astro.url.pathname, site);
const isLocal = ['localhost', '127.0.0.1', '[::1]'].includes(site.hostname);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#183D32" />
    {(noindex || isLocal) && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Что приготовить за 30 минут" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(image, site)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema.map((item) => <script type="application/ld+json" is:inline set:html={serializeSchema(item)} />)}
  </head>
  <body>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
